{
    "$version": "1",

    "name": "Hostname & DNS",
    "description": "設定自訂主機名稱，並透過 mDNS（.local）在區域網路上公告，方便找到印表機。",
    "version": "1.0",

    "properties": {
        "hostname": {
            "display": "主機名稱",
            "type": "text",
            "default": ""
        },
        "dhcp_hostname": {
            "display": "透過 DHCP 傳送主機名稱",
            "type": "enum",
            "options": ["False", "True"],
            "default": "True"
        }
    }
}
