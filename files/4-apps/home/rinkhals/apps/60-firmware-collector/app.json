{
    "$version": "1",

    "name": "Firmware Collector (opt-in)",
    "description": "定期使用印表機本身的裝置憑證，向 Anycubic 查詢此型號是否有新韌體。若有新版本，只會將下載網址和版本中繼資料傳送至 Rinkhals 社群典藏站（rinkhals.firmwareforge.org），以加速製作修補程式。不會傳送憑證、帳號資訊或任何個人資料。預設停用。",
    "version": "1.0",

    "properties": {
        "ingest_endpoint": {
            "display": "資料接收端點網址",
            "type": "text",
            "default": "https://ingest.firmwareforge.org/v1/notify",
            "advanced": true
        },
        "check_interval_hours": {
            "display": "檢查間隔（小時）",
            "type": "text",
            "default": "24"
        },
        "dry_run": {
            "display": "試執行（僅記錄，不上傳）",
            "type": "enum",
            "options": ["False", "True"],
            "default": "False",
            "advanced": true
        }
    }
}
